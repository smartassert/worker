includes:
  - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon
parameters:
  treatPhpDocTypesAsCertain: false
  level: 9
  paths:
    - src
    - tests
  inferPrivatePropertyTypeFromConstructor: true
  exceptions:
    check:
      tooWideThrowType: true
  ignoreErrors:
    -
      message: '#Method .+TestRepository::getSingleIntegerResult\(\) has parameter \$query with generic class Doctrine\\ORM\\Query#'
      path: src/Repository/TestRepository.php
